---
import { getCollection } from "astro:content";
import { gaEventAttributes } from "@hagicode/hagilight-core/analytics-events";
import { locales } from "@hagicode/hagilight-starlight/locales";
import { HOME_HERO } from "../analytics-locations.mjs";
import { getWelcomeCopy } from "../home-copy.mjs";
import CollectionBrowser from "./CollectionBrowser.astro";

const locale = Astro.locals.starlightRoute.locale ?? "root";
const copy = getWelcomeCopy(locale);
const prefix = locale === "root" ? "" : `/${locale}`;
const docPrefix = locale === "root" ? "awesome/" : `${locale}/awesome/`;
const hosted = await getCollection("docs", ({ id, data }) => Boolean(data.awesomeSource) && id.startsWith(docPrefix));
const number = new Intl.NumberFormat(locale === "root" ? "en-US" : locale);
const stats = [
  { value: hosted.length, label: copy.collections },
  { value: new Set(hosted.flatMap(({ data }) => data.tags ?? [])).size, label: copy.topics },
  { value: Object.keys(locales).length, label: copy.languages },
];
---

<div class="awesome-welcome">
  <section class="awesome-welcome-hero" aria-labelledby="awesome-welcome-title">
    <div class="awesome-welcome-copy">
      <p class="awesome-welcome-eyebrow"><span aria-hidden="true"></span>{copy.eyebrow}</p>
      <h2 id="awesome-welcome-title">{copy.title}</h2>
      <p class="awesome-welcome-intro">{copy.intro}</p>
      <div class="awesome-welcome-actions">
        <a class="awesome-welcome-primary" href={`${prefix}/awesome/`} {...gaEventAttributes({ category: "navigation", label: "exploreCollections", location: HOME_HERO })}>
          {copy.explore}<span aria-hidden="true">&#8599;</span>
        </a>
        <a class="awesome-welcome-secondary" href="#awesome-start" {...gaEventAttributes({ category: "navigation", label: "startBrowsing", location: HOME_HERO })}>
          {copy.start}<span aria-hidden="true">&#8595;</span>
        </a>
      </div>
    </div>
    <div class="awesome-welcome-art" aria-hidden="true">
      <div class="awesome-welcome-orbit awesome-welcome-orbit-outer"></div>
      <div class="awesome-welcome-orbit awesome-welcome-orbit-inner"></div>
      <span class="awesome-welcome-node awesome-welcome-node-code">&lt;/&gt;</span>
      <span class="awesome-welcome-node awesome-welcome-node-star">&#10022;</span>
      <span class="awesome-welcome-node awesome-welcome-node-branch">&#9282;</span>
      <span class="awesome-welcome-monogram">A<span>&#8226;</span></span>
    </div>
  </section>

  <dl class="awesome-welcome-stats">
    {stats.map(({ value, label }) => <div><dt>{label}</dt><dd>{number.format(value)}</dd></div>)}
  </dl>

  <CollectionBrowser />

  <div class="awesome-welcome-features">
    {copy.features.map(({ title, body }, index) => <section>
      <span class="awesome-welcome-feature-index" aria-hidden="true">{number.format(index + 1).padStart(2, "0")}</span>
      <h3>{title}</h3>
      <p>{body}</p>
    </section>)}
  </div>
</div>
