---
import StarlightPageFrame from "@astrojs/starlight/components/PageFrame.astro";
import ExternalLinkWarning from "./ExternalLinkWarning.astro";
---

<StarlightPageFrame>
  <slot />
  {Astro.slots.has("header") && <Fragment slot="header"><slot name="header" /></Fragment>}
  {Astro.slots.has("sidebar") && <Fragment slot="sidebar"><slot name="sidebar" /></Fragment>}
</StarlightPageFrame>
<ExternalLinkWarning />
<script>import "../outbound-tracking.mjs";</script>
